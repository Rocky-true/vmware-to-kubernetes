# 复制为 backend.tf 后执行 terraform init -migrate-state。
# 凭证不要写进文件：使用 ALICLOUD_ACCESS_KEY / ALICLOUD_SECRET_KEY 环境变量，
# 或先在本地完成 `terraform login`/配置 profile。
terraform {
  backend "oss" {
    bucket  = "replace-with-your-tfstate-bucket"
    key     = "course-k8s-lab/prod/terraform.tfstate"
    region  = "cn-guangzhou"
    encrypt = true
    acl     = "private"
  }
}
